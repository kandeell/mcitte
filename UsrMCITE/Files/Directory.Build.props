		<Compile Include="$(PkgPath)/UsrMCITE/Schemas/UsrProvisioning/UsrProvisioning.cs" Condition="Exists('$(PkgPath)/UsrMCITE/Schemas/UsrProvisioning/UsrProvisioning.cs')" />
		<Compile Include="$(PkgPath)/UsrMCITE/Schemas/UsrVirtualMachineInven/UsrVirtualMachineInven.cs" Condition="Exists('$(PkgPath)/UsrMCITE/Schemas/UsrVirtualMachineInven/UsrVirtualMachineInven.cs')" />
